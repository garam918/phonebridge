            "value": "Quit other MTP apps such as Android File Transfer if they are running."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Android File Transfer 같은 다른 MTP 프로그램이 실행 중이면 종료하세요."
          }
        }
      }
    },
