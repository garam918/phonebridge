    "conflict.app.thirdParty": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Other MTP apps such as OpenMTP, MacDroid or Smart Switch"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "OpenMTP, MacDroid, Smart Switch 등 다른 MTP 프로그램"
          }
        }
      }
    },
    "conflict.description": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "An MTP device can be used by only one program at a time. Another program claimed the device's MTP interface first, so PhoneBridge could not access it."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "MTP 기기는 한 번에 한 프로그램만 사용할 수 있습니다. 다른 프로그램이 기기의 MTP 인터페이스를 먼저 점유해 PhoneBridge가 접근하지 못했습니다."
          }
        }
      }
    },
    "conflict.noAutoKill": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "PhoneBridge never terminates other programs or system processes on its own."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "PhoneBridge는 다른 프로그램이나 시스템 프로세스를 임의로 종료하지 않습니다."
          }
        }
      }
    },
    "conflict.owner": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
