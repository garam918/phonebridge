    "guide.locked.footnote": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Storage appears automatically once the device is unlocked. If it doesn't, click Retry or reconnect the cable."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "잠금을 해제하면 저장소가 자동으로 나타납니다. 계속 보이지 않으면 '다시 시도'를 누르거나 케이블을 다시 연결하세요."
          }
        }
      }
    },
    "guide.locked.step1": {
