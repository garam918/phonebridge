    "state.waitingForMTP.fileTransfer.description": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The device is connected over USB but is in charging-only mode. To access files, change the device's USB mode to “File transfer”."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "USB로는 연결되었지만 Android 기기가 충전 전용 모드입니다. 파일에 접근하려면 기기에서 USB 사용 목적을 '파일 전송'으로 바꿔 주세요."
          }
        }
      }
    },
    "state.waitingForMTP.locked": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Unlock Your Device"
          }
        },
