    "onboarding.start": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Get Started"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시작하기"
          }
        }
      }
    },
    "onboarding.step1.text": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Connect your Android device to the Mac with a cable that supports data transfer."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "데이터 전송을 지원하는 케이블로 Android 기기를 Mac에 연결하세요."
          }
        }
      }
    },
    "onboarding.step1.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Connect with a USB Cable"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "USB 케이블로 연결"
          }
        }
      }
    },
    "onboarding.step2.text": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In the device’s notification, set “Use USB for” to “File transfer”, then tap “Allow” when asked."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기기의 알림에서 'USB 사용 목적'을 '파일 전송'으로 바꾸고, 접근 허용 창이 뜨면 '허용'을 누르세요."
          }
        }
      }
    },
    "onboarding.step2.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose File Transfer Mode"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "파일 전송 모드 선택"
          }
        }
      }
    },
    "onboarding.step3.text": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Drag files between the Android and Mac panes, or Control-click a file to download or upload."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Android | Mac 나란히 보기에서 끌어다 놓거나, 파일을 우클릭해 다운로드·업로드하세요."
          }
        }
      }
    },
    "onboarding.step3.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Move Files"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "파일 주고받기"
          }
        }
      }
    },
    "onboarding.step4.text": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turn it on in Settings › Finder to see the device’s storage in the Finder sidebar."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "설정 › Finder에서 켜면 Finder 사이드바에 기기의 저장소가 나타납니다."
          }
        }
      }
    },
    "onboarding.step4.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use Finder (Optional)"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Finder에서 보기 (선택)"
          }
        }
      }
    },
    "onboarding.step4.unavailable": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Finder sidebar access needs macOS 26 or later. On this Mac, move files with the PhoneBridge window and its Mac pane."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Finder 사이드바 연결은 macOS 26 이상에서 사용할 수 있습니다. 이 Mac에서는 PhoneBridge 창과 Mac 패널로 파일을 옮기세요."
          }
        }
      }
    },
    "onboarding.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Browse and transfer files on your Android device from your Mac."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Android 기기의 파일을 Mac에서 살펴보고 주고받을 수 있습니다."
          }
        }
      }
    },
    "onboarding.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Welcome to PhoneBridge"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "PhoneBridge에 오신 것을 환영합니다"
          }
        }
      }
    },
