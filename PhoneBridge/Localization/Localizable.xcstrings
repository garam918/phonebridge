    "quit.confirm.message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Unfinished transfers are cancelled and their partial files removed. Files that already finished are kept."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "종료하면 끝나지 않은 전송은 취소되고 받던 임시 파일은 지워집니다. 이미 끝난 파일은 그대로 남습니다."
          }
        }
      }
    },
    "quit.confirm.quit": {
