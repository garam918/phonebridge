{
  "sourceLanguage": "ko",
  "strings": {
    "a11y.dropTarget": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Drop files here to upload them to the current folder on the Android device"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "파일을 여기에 놓으면 Android 기기의 현재 폴더로 업로드됩니다"
          }
        }
      }
    },
