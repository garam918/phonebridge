    "remedy.deviceBusy": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Quit other MTP apps such as Android File Transfer or Image Capture, then try again."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Android File Transfer, 이미지 캡처 같은 다른 MTP 프로그램을 종료한 뒤 다시 시도하세요."
          }
        }
      }
    },
    "remedy.disconnected": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reconnect the cable, unlock the device, then click Retry."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "케이블을 다시 연결하고 기기 잠금을 해제한 뒤 '다시 시도'를 누르세요."
          }
