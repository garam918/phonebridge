    "finder.problem.busy": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn’t unmount because files are open in Finder. Close them and try again."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Finder에서 열려 있는 파일이 있어 연결을 해제하지 못했습니다. 파일을 닫은 뒤 다시 시도하세요."
          }
        }
      }
    },
    "finder.problem.extensionDisabled": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The “PhoneBridge Finder” extension is turned off, so storage can’t be mounted in Finder. Turn it on in System Settings › General › Login Items & Extensions › File System Extensions."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "'PhoneBridge Finder' 확장이 꺼져 있어 Finder에 연결할 수 없습니다. 시스템 설정 › 일반 › 로그인 항목 및 확장 프로그램 › 파일 시스템 확장에서 켜세요."
          }
        }
      }
    },
    "finder.problem.generic": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn’t mount in Finder. Reconnect the device or relaunch PhoneBridge. (%@)"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Finder에 연결하지 못했습니다. 기기를 다시 연결하거나 PhoneBridge를 다시 실행해 보세요. (%@)"
          }
        }
      }
    },
    "finder.problem.serverUnavailable": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "PhoneBridge and its Finder extension couldn’t talk to each other. Try relaunching PhoneBridge."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "PhoneBridge와 Finder 확장이 서로 연결되지 않았습니다. PhoneBridge를 다시 실행해 보세요."
          }
        }
      }
    },
    "finder.recovery.discard": {
