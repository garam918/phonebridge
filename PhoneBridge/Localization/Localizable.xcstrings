    "finder.manualMountNote": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This macOS version can't mount from the app (macOS 27 or later is required). You can mount with mount -F in Terminal."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 macOS 버전에서는 앱에서 바로 Finder에 연결할 수 없습니다(macOS 27 이상 필요). 터미널의 mount -F 명령으로 연결할 수 있습니다."
          }
        }
      }
    },
