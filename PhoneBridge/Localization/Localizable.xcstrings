    "remedy.insufficientDeviceSpace": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Free up space on the device or choose other storage such as an SD card, then try again."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기기에서 필요 없는 파일을 지우거나 SD 카드 같은 다른 저장소를 선택한 뒤 다시 시도하세요."
          }
        }
      }
    },
    "remedy.insufficientLocalSpace": {
