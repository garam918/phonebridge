          "stringUnit": {
            "state": "translated",
            "value": "기기 잠금을 해제해 주세요"
          }
        }
      }
    },
    "state.waitingForMTP.locked.description": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The device is connected but locked, so its files aren’t visible yet. Unlock it and allow access to its data, and PhoneBridge continues automatically."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기기는 연결되었지만 잠겨 있어 파일을 볼 수 없습니다. 기기의 잠금을 해제하고 데이터 접근을 허용하면 자동으로 이어집니다."
          }
        }
      }
    },
