    "finder.recovery.explain": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "These files were written in Finder but never reached the device. Save them to your Mac or discard them."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Finder에서 기기로 쓰다가 기기에 올라가지 못한 파일입니다. Mac에 저장하거나 버릴 수 있습니다."
          }
        }
      }
    },
