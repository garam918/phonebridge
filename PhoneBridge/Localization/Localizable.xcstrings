    "settings.language.note": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The app’s screens, menus, tooltips and error messages change right away. Menu items provided by macOS (Services, Edit, Window, …), buttons in file panels and the Settings window title change after the app is relaunched."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "앱의 화면, 메뉴, 툴팁, 오류 메시지는 바로 바뀝니다. macOS가 제공하는 메뉴 항목(서비스, 편집, 윈도우 등)과 파일 선택 창의 버튼, 설정 창 제목은 앱을 다시 실행하면 바뀝니다."
          }
