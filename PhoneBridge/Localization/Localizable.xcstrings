    "finder.status": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Status"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "상태"
          }
        }
      }
    },
    "finder.unavailableOS": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Showing the device in Finder needs macOS 26 or later (this Mac: %@). Browsing and transfers in the PhoneBridge window work as usual."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Finder에 연결하려면 macOS 26 이상이 필요합니다(이 Mac: %@). PhoneBridge 창에서는 모든 파일 탐색과 전송을 그대로 사용할 수 있습니다."
          }
        }
      }
    },
    "finder.unmount": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Unmount from Finder"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Finder에서 연결 해제"
          }
        }
      }
    },
    "finder.volume.readOnly": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Read-only"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "읽기 전용"
          }
        }
      }
    },
    "finder.volume.writable": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Writable (experimental)"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "쓰기 가능 (실험적)"
          }
        }
      }
    },
    "finder.volumes": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Storage"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "저장소"
          }
        }
      }
    },
    "finder.writes.confirmEnable": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "허용"
          }
        }
      }
    },
    "finder.writes.confirmMessage": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This is an experimental feature. Originals on the device are protected: new files are uploaded under a temporary name and checked before they replace anything. Still, back up important files first. Files you delete in Finder do not go to the Trash."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "실험 기능입니다. 기기의 원본은 새 파일을 임시 이름으로 올려 확인한 뒤에 바꾸는 방식으로 보호되지만, 중요한 파일은 미리 백업해 두세요. Finder에서 지운 파일은 휴지통으로 가지 않습니다."
          }
        }
      }
    },
    "finder.writes.confirmTitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow writing from Finder?"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Finder에서 쓰기를 허용할까요?"
          }
        }
      }
    },
    "finder.writes.demoOnly": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "For now, writing goes only to the virtual device. Turn on the option above to write to real devices."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지금은 가상 기기에만 씁니다. 실제 기기에 쓰려면 위 항목을 켜세요."
          }
        }
      }
    },
    "finder.writes.enable": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow writing from Finder"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Finder에서 쓰기 허용"
          }
        }
      }
    },
    "finder.writes.experimental": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Experimental"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "실험적"
          }
        }
      }
    },
    "finder.writes.offNote": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "While this is off, Finder volumes are read-only: copy to your Mac and preview in Finder, and use the PhoneBridge window to send files to Android."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "꺼져 있으면 Finder 볼륨은 읽기 전용입니다. Finder에서는 Mac으로 복사하고 미리볼 수 있으며, Android로 보내려면 PhoneBridge 창을 사용하세요."
          }
        }
      }
    },
    "finder.writes.onNote": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can copy to the device, create folders, rename and delete in Finder. Files are first saved on your Mac and sent to the device when they are closed, so a large copy may seem to pause near the end. Deleting takes effect right away, without the Trash. Finder information such as tags is not stored on the device."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Finder에서 기기로 복사하고, 새 폴더를 만들고, 이름을 바꾸고, 삭제할 수 있습니다. 파일은 Mac에 먼저 저장되었다가 닫힐 때 기기로 올라가므로, 큰 파일은 복사가 끝날 즈음 잠시 멈춘 것처럼 보일 수 있습니다. 삭제는 휴지통을 거치지 않고 바로 반영됩니다. 태그 같은 Finder 정보는 기기에 저장되지 않습니다."
          }
        }
      }
    },
    "finder.writes.realDevices": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Also allow writing to real Android devices"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "실제 Android 기기에도 쓰기 허용"
          }
        }
      }
    },
    "finder.writes.realDevicesConfirmMessage": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Copying, renaming and deleting in Finder will change the phone right away. Files deleted on the device cannot be recovered. Originals are protected (new files are checked before they replace anything), but only one model has been verified, so back up important files first."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Finder에서 휴대전화로 복사, 이름 변경, 삭제가 바로 반영됩니다. 기기에서 지운 파일은 되돌릴 수 없습니다. 원본은 새 파일을 확인한 뒤에 바꾸는 방식으로 보호되지만, 아직 한 기종에서만 검증되었으니 중요한 파일은 먼저 백업하세요."
          }
        }
      }
    },
    "finder.writes.realDevicesConfirmTitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow Finder to write to real devices?"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "실제 기기에 Finder 쓰기를 허용할까요?"
          }
        }
      }
    },
    "finder.writes.realDevicesOnNote": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Writing to real devices. Only the Galaxy S25 Edge has been verified; on other devices, try a folder with nothing important first."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "실제 기기에 씁니다. 검증된 기기는 Galaxy S25 Edge 한 종입니다. 다른 기기에서는 먼저 중요하지 않은 폴더로 시험해 보세요."
          }
        }
      }
    },
    "finder.writes.remount": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Changing this briefly unmounts and remounts storage shown in Finder. Storage with open files is not remounted."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "설정을 바꾸면 Finder에 연결된 저장소를 잠시 해제했다가 다시 연결합니다. 열려 있는 파일이 있으면 다시 연결되지 않습니다."
          }
        }
      }
    },
    "finder.writes.section": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Writing from Finder"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Finder에서 쓰기"
          }
        }
      }
    },
    "guide.fileTransfer.samsungNote": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Samsung Galaxy: tap the “USB settings” notification → “Use USB for” → “Transferring files / Android Auto”. Without a notification, check Settings › Connected devices › USB, or “Default USB configuration” in Developer options. Menu names vary by model and Android version."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "삼성 Galaxy: 알림의 'USB 설정' → 'USB 사용 목적' → '파일 전송/Android Auto'. 알림이 보이지 않으면 설정 › 연결된 기기 › USB 또는 개발자 옵션의 '기본 USB 설정'을 확인하세요. 기종과 Android 버전에 따라 메뉴 이름이 다를 수 있습니다."
          }
        }
      }
    },
    "guide.fileTransfer.step1": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Unlock the device."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기기의 잠금을 해제합니다."
          }
        }
      }
    },
    "guide.fileTransfer.step2": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Swipe down from the top of the screen and tap the “Charging this device via USB” (or “USB settings”) notification."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "화면 위쪽에서 아래로 쓸어내려 알림창을 열고 'USB로 충전 중' 또는 'USB 설정' 알림을 누릅니다."
          }
        }
      }
    },
    "guide.fileTransfer.step3": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Under “Use USB for”, select “File transfer” (or “Transferring files / Android Auto”)."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "'USB 사용 목적'에서 '파일 전송'(또는 '파일 전송/Android Auto')을 선택합니다."
          }
        }
      }
    },
    "guide.fileTransfer.step4": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If asked “Allow access to device data?”, tap “Allow”. PhoneBridge reconnects automatically."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "'기기 데이터에 대한 접근을 허용하시겠습니까?' 창이 뜨면 '허용'을 누릅니다. PhoneBridge가 자동으로 다시 연결합니다."
          }
        }
      }
    },
    "guide.fileTransfer.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
